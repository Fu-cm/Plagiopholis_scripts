# 3. TREE TOPOLOGY AND BRANCH LENGTHS

print("Setting up tree model...")

out_group = clade("Thermophis_zhaoermii")

topology ~ dnUniformTopology(taxa, outgroup=out_group)
moves.append( mvNNI(topology, weight=num_taxa) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

for (i in 1:num_branches) {
    bl[i] ~ dnExponential(10.0)
    moves.append( mvScale(bl[i]) )
}

TL := sum(bl)
psi := treeAssembly(topology, bl)

print("Tree model defined.")


# 4. SUBSTITUTION MODELS

print("Setting up substitution models...")

# Define priors
pi_prior <- v(1,1,1,1)
er_prior <- v(1,1,1,1,1,1)
pi_equal <- rep(0.25, 4)

# ==== Partition 1: GTR+G ====
pi1 ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi1, weight=2) )
moves.append( mvDirichletSimplex(pi1, weight=1) )
er1 ~ dnDirichlet(er_prior)
moves.append( mvBetaSimplex(er1, weight=2) )
moves.append( mvDirichletSimplex(er1, weight=1) )
Q1 := fnGTR(er1, pi1)
alpha1 ~ dnExponential(1.0)
moves.append( mvScale(alpha1, weight=2) )
rates1 := fnDiscretizeGamma(alpha1, alpha1, 4)

# ==== Partition 2: GTR+I+G ====
pi2 ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi2, weight=2) )
moves.append( mvDirichletSimplex(pi2, weight=1) )
er2 ~ dnDirichlet(er_prior)
moves.append( mvBetaSimplex(er2, weight=2) )
moves.append( mvDirichletSimplex(er2, weight=1) )
Q2 := fnGTR(er2, pi2)
alpha2 ~ dnExponential(1.0)
moves.append( mvScale(alpha2, weight=2) )
p_inv2 ~ dnBeta(1,1)
moves.append( mvScale(p_inv2, weight=2) )
rates2 := fnDiscretizeGamma(alpha2, alpha2, 4)

# ==== Partition 3: GTR+G ====
