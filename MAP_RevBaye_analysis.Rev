print("PhyloCTMC models defined.")


# 6. CREATE THE MODEL

print("Creating model object...")

# Use psi as the root node (proven to work in diagnostic test)
mymodel = model(psi)

print("Model object created.")


# 7. SET UP MONITORS

print("Setting up monitors...")

monitors.append( mnModel(filename="output/13p2s_partitioned.log", printgen=1000) )
monitors.append( mnFile(filename="output/13p2s_partitioned.trees", printgen=1000, psi) )
monitors.append( mnScreen(printgen=2000, TL) )


# 8. RUN SINGLE CHAIN MCMC

print("Starting MCMC analysis...")
print("Generations: 10,000,000")
print("Sample frequency: 1000 generations")
print("Total samples: 10,000")

mymcmc = mcmc(mymodel, monitors, moves)
mymcmc.run(generations=10000000)

print("MCMC run completed!")


# 9. POST-PROCESSING: MAP TREE

print("")
print("Starting post-processing...")

treetrace = readTreeTrace("output/13p2s_partitioned.trees", treetype="non-clock", burnin=0.25)

map_tree = mapTree(treetrace, "output/13p2s_partitioned_MAP.tre", conditionalAges=TRUE)

print("MAP tree saved to: output/13p2s_partitioned_MAP.tre")

ess_values <- treetrace.ESS()
print("ESS values:")
print(ess_values)

if (ess_values < 200) {
    print("WARNING: ESS values below 200. Consider increasing generations.")
} else {
    print("All ESS values above 200. MCMC appears to have converged.")
}

print("")
print("========================================")
print("Analysis completed successfully!")
print("========================================")

q()