####################################################################
# RevBayes Script: Bayesian inference of phylogeny with 22 partitions
# Based on PartitionFinder results for 13 protein-coding genes and 2rRNAs
# MCMC: Single chain - Using independent variables for each partition
####################################################################


# 1. LOADING THE DATA


data = readDiscreteCharacterData("13p2s.nexus")

num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3
taxa <- data.taxa()

data

moves    = VectorMoves()
monitors = VectorMonitors()

print("Data loaded successfully!")
print("Number of taxa: " + num_taxa)
print("Number of branches: " + num_branches)


# 2. DEFINING PARTITIONS

print("Defining 22 partitions...")

# Subset1: GTR+G
pos1 <- seq(11266, 12198, 3)
pos1 <- append(pos1, seq(1, 963, 3))
pos1 <- append(pos1, seq(6526, 7860, 3))
pos1 <- append(pos1, seq(5896, 6237, 3))

# Subset2: GTR+I+G
pos2 <- seq(2, 963, 3)
pos2 <- append(pos2, seq(10157, 11265, 3))
pos2 <- append(pos2, seq(6239, 6525, 3))
pos2 <- append(pos2, seq(6527, 7860, 3))

# Subset3: GTR+G
pos3 <- seq(966, 1992, 3)
pos3 <- append(pos3, seq(3, 963, 3))

# Subset4: GTR+I
pos4 <- seq(6238, 6525, 3)
pos4 <- append(pos4, seq(7861, 9639, 3))
pos4 <- append(pos4, seq(964, 1992, 3))

# Subset5: GTR+G
pos5 <- seq(965, 1992, 3)

# Subset6: GTR+I
pos6 <- seq(1993, 3591, 3)

# Subset7: GTR+I
pos7 <- seq(1994, 3591, 3)

# Subset8: GTR+G
pos8 <- seq(1995, 3591, 3)
pos8 <- append(pos8, seq(5898, 6237, 3))

# Subset9: GTR+I (equal frequencies)
pos9 <- seq(5113, 5895, 3)
pos9 <- append(pos9, seq(3592, 4272, 3))

# Subset10: GTR+I
pos10 <- seq(3593, 4272, 3)
pos10 <- append(pos10, seq(5114, 5895, 3))

# Subset11: GTR+G
pos11 <- seq(6528, 7860, 3)
pos11 <- append(pos11, seq(5115, 5895, 3))
pos11 <- append(pos11, seq(3594, 4272, 3))

# Subset12: K80+I
pos12 <- seq(4274, 4434, 3)
pos12 <- append(pos12, seq(4273, 4434, 3))

# Subset13: K80+I+G
pos13 <- seq(6240, 6525, 3)
pos13 <- append(pos13, seq(4437, 5112, 3))
pos13 <- append(pos13, seq(4275, 4434, 3))

# Subset14: K80+G
pos14 <- seq(4435, 5112, 3)

# Subset15: GTR+I
pos15 <- seq(4436, 5112, 3)
pos15 <- append(pos15, seq(5897, 6237, 3))

# Subset16: GTR+I+G
pos16 <- seq(7862, 9639, 3)

# Subset17: GTR+G
pos17 <- seq(7863, 9639, 3)
pos17 <- append(pos17, seq(10158, 11265, 3))

# Subset18: GTR+G
pos18 <- seq(9640, 10155, 3)

# Subset19: K80+G
pos19 <- seq(9641, 10155, 3)

# Subset20: K80
pos20 <- seq(9642, 10155, 3)

# Subset21: GTR+I
pos21 <- seq(10156, 11265, 3)
pos21 <- append(pos21, seq(12199, 13700, 3))

# Subset22: GTR+I+G
pos22 <- seq(11267, 12198, 3)
pos22 <- append(pos22, seq(11268, 12198, 3))
pos22 <- append(pos22, seq(12200, 13700, 3))
pos22 <- append(pos22, seq(12201, 13700, 3))

print("=== Partition Sizes ===")
print("Subset1: " + pos1.size() + " positions")
print("Subset2: " + pos2.size() + " positions")
