# 5. PHYLOGENETIC MODELS

print("Setting up PhyloCTMC models...")

function getPartitionData(positions) {
    current_chars <- data.getIncludedCharacterIndices()
    data.excludeAll()
    data.includeCharacter(positions)
    partition_data <- data
    data.excludeAll()
    data.includeCharacter(current_chars)
    return partition_data
}

print("Creating partition 1...")
data_1 <- getPartitionData(pos1)
seq1 ~ dnPhyloCTMC(tree=psi, Q=Q1, siteRates=rates1, type="DNA")
seq1.clamp(data_1)

print("Creating partition 2...")
data_2 <- getPartitionData(pos2)
seq2 ~ dnPhyloCTMC(tree=psi, Q=Q2, siteRates=rates2, pInv=p_inv2, type="DNA")
seq2.clamp(data_2)

print("Creating partition 3...")
data_3 <- getPartitionData(pos3)
